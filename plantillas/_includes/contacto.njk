---
layout: base.njk
---
{% from "iconos.njk" import icono %}

{# ENCABEZADO #}
<section class="pagina-cab" aria-labelledby="contacto-titulo">
  <div class="contenedor">
    <h1 id="contacto-titulo">{{ encabezado.titulo }}</h1>
    <p class="intro intro--grande">{{ encabezado.texto }}</p>
  </div>
</section>

{# CANALES #}
<section class="seccion seccion--niebla seccion--compacta" id="canales" aria-labelledby="canales-titulo">
  <div class="contenedor">
    <h2 id="canales-titulo" class="h2--medio">{{ canales.titulo }}</h2>
    <ul class="contacto-canales">
      <li class="contacto-canal contacto-canal--principal">
        <div class="contacto-canal__nombre">{{ icono("calendario") }}<h3>Doctoralia</h3></div>
        <div class="contacto-canal__valor">
          <a class="btn" href="{{ sitio.doctoralia_url }}" target="_blank" rel="noopener noreferrer">{{ canales.doctoralia_boton }}{{ icono("flecha") }}</a>
        </div>
      </li>
      <li class="contacto-canal">
        <div class="contacto-canal__nombre">{{ icono("whatsapp") }}<h3>WhatsApp</h3></div>
        <div class="contacto-canal__valor"><a class="enlace" href="{{ sitio.whatsapp_url }}" target="_blank" rel="noopener noreferrer">{{ sitio.telefono }}</a></div>
      </li>
      <li class="contacto-canal">
        <div class="contacto-canal__nombre">{{ icono("telefono") }}<h3>Teléfono</h3></div>
        <div class="contacto-canal__valor"><a class="enlace" href="{{ sitio.telefono_url }}">{{ sitio.telefono }}</a></div>
      </li>
      <li class="contacto-canal">
        <div class="contacto-canal__nombre">{{ icono("correo") }}<h3>Correo electrónico</h3></div>
        <div class="contacto-canal__valor"><a class="enlace" href="mailto:{{ sitio.correo }}">{{ sitio.correo }}</a></div>
      </li>
    </ul>
  </div>
</section>

{# UBICACIONES #}
<section class="seccion seccion--compacta" id="ubicaciones" aria-labelledby="ubicaciones-titulo">
  <div class="contenedor">
    <h2 id="ubicaciones-titulo" class="h2--medio">{{ ubicaciones.titulo }}</h2>
    <ul class="ubicaciones">
      {% for u in sitio.ubicaciones %}
      <li class="ubicacion">
        {{ icono("pin") }}
        <div>
          <h3>{{ u.nombre }}</h3>
          <p>{{ u.calle }}<br>{{ u.localidad }}</p>
          <a class="enlace" href="{{ u.mapa_url }}" target="_blank" rel="noopener noreferrer">{{ ubicaciones.boton }}{{ icono("flecha") }}</a>
        </div>
      </li>
      {% endfor %}
    </ul>
    <div class="ubicaciones__otras">
      <p>{{ ubicaciones.otras }}</p>
      <a class="enlace" href="{{ ubicaciones.enlace_url }}">{{ ubicaciones.enlace }}{{ icono("flecha") }}</a>
    </div>
  </div>
</section>

{# INSTAGRAM #}
<section class="seccion seccion--niebla seccion--franja" aria-label="Instagram">
  <div class="contenedor franja-instagram">
    <p>{{ instagram.texto }}</p>
    <a class="canal-discreto" href="{{ sitio.instagram_url }}" target="_blank" rel="noopener noreferrer">{{ icono("instagram") }}<span>{{ instagram.usuario }}</span></a>
  </div>
</section>
