---
layout: base.njk
---
{% from "iconos.njk" import icono %}

{# ENCABEZADO E ÍNDICE DE CATEGORÍAS #}
<section class="pagina-cab" aria-labelledby="faq-pag-titulo">
  <div class="contenedor">
    <h1 id="faq-pag-titulo">{{ encabezado.titulo }}</h1>
    <p class="intro intro--grande">{{ encabezado.texto }}</p>
    <nav class="servicios-nav" aria-label="Categorías">
      {% for c in collections.faqCategorias %}<a href="#{{ c.id }}">{{ c.nombre }}</a>{% endfor %}
    </nav>
  </div>
</section>

{# UNA SECCIÓN POR CATEGORÍA (solo aparecen las que tienen preguntas) #}
{% for c in collections.faqCategorias %}
<section class="seccion{% if loop.index % 2 == 1 %} seccion--niebla{% endif %}" id="{{ c.id }}" aria-labelledby="titulo-{{ c.id }}">
  <div class="contenedor dos">
    <div>
      <h2 id="titulo-{{ c.id }}" class="h2--ficha">{{ c.nombre }}</h2>
      {% for b in bloques %}{% if b.nombre == c.nombre and b.texto %}<p class="intro">{{ b.texto }}</p>{% endif %}{% endfor %}
    </div>
    <div class="faq">
      {% for f in c.preguntas %}
      <details>
        <summary>{{ f.data.pregunta }}</summary>
        <div class="respuesta">{{ f.data.respuesta | parrafos | safe }}</div>
      </details>
      {% endfor %}
    </div>
  </div>
</section>
{% endfor %}

{# CIERRE #}
<section class="cierre cierre--texto" aria-labelledby="cierre-faq-titulo">
  <div class="contenedor">
    <h2 id="cierre-faq-titulo">{{ cierre.titulo }}</h2>
    <p class="cierre__texto">{{ cierre.texto }}</p>
    <div class="acciones acciones--arriba">
      <a class="btn" href="{{ sitio.cita_url }}">Pedir cita</a>
      <a class="enlace" href="{{ sitio.contacto_url }}">Contactar{{ icono("flecha") }}</a>
    </div>
  </div>
</section>
