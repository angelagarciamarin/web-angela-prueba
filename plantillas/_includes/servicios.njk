---
layout: base.njk
---
{% from "iconos.njk" import icono %}

{# ENCABEZADO #}
<section class="pagina-cab" aria-labelledby="servicios-pag-titulo">
  <div class="contenedor">
    <h1 id="servicios-pag-titulo">{{ encabezado.titulo }}</h1>
    <p class="intro intro--grande">{{ encabezado.texto }}</p>
    <nav class="servicios-nav" aria-label="Servicios">
      {% for s in lista %}<a href="#{{ s.id }}">{{ s.corto }}</a>{% endfor %}
      <a href="#talleres-infantiles">Talleres infantiles</a>
    </nav>
  </div>
</section>

{# UNA FICHA POR SERVICIO #}
{% for s in lista %}
<section class="seccion{% if loop.index % 2 == 1 %} seccion--niebla{% endif %}" id="{{ s.id }}" aria-labelledby="titulo-{{ s.id }}">
  <div class="contenedor dos">
    <div>
      <h2 id="titulo-{{ s.id }}" class="h2--ficha">{{ s.titulo }}</h2>
      <p class="modalidad">{{ s.modalidad }}</p>
    </div>
    <div class="texto-largo">
      <p class="destacado">{{ s.frase }}</p>
      {% for p in s.parrafos %}<p>{{ p }}</p>{% endfor %}
    </div>
  </div>
</section>
{% endfor %}

{# TALLERES INFANTILES #}
{% set total = lista | length %}
<section class="seccion{% if total % 2 == 0 %} seccion--niebla{% endif %}" id="talleres-infantiles" aria-labelledby="titulo-talleres-serv">
  <div class="contenedor dos">
    <h2 id="titulo-talleres-serv" class="h2--ficha">{{ talleres.titulo }}</h2>
    <div class="texto-largo">
      <p class="destacado">{{ talleres.texto }}</p>
      <a class="enlace" href="{{ talleres.enlace_url }}">{{ talleres.enlace }}{{ icono("flecha") }}</a>
    </div>
  </div>
</section>

{# MODALIDADES #}
<section class="seccion{% if total % 2 == 1 %} seccion--niebla{% endif %}" id="modalidades" aria-labelledby="modalidades-titulo">
  <div class="contenedor dos">
    <h2 id="modalidades-titulo" class="h2--ficha">{{ modalidades.titulo }}</h2>
    <div class="texto-largo">
      <ul class="modalidades-resumen">
        {% for m in modalidades.lista %}<li>{{ m }}</li>{% endfor %}
      </ul>
      <a class="enlace" href="{{ modalidades.enlace_url }}">{{ modalidades.enlace }}{{ icono("flecha") }}</a>
    </div>
  </div>
</section>

{# CIERRE #}
<section class="cierre cierre--texto" aria-labelledby="cierre-serv-titulo">
  <div class="contenedor">
    <h2 id="cierre-serv-titulo">{{ cierre.titulo }}</h2>
    <div class="acciones acciones--arriba">
      <a class="btn" href="{{ sitio.cita_url }}">Pedir cita</a>
      <a class="enlace" href="{{ sitio.contacto_url }}">Contactar{{ icono("flecha") }}</a>
    </div>
  </div>
</section>
