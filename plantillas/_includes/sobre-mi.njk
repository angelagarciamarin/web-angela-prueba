---
layout: base.njk
---
{% from "iconos.njk" import icono %}

{# 1 · PRESENTACIÓN #}
<section class="sobre-cab{% if presentacion.foto %} sobre-cab--foto{% endif %}" aria-labelledby="sobre-titulo">
  <div class="contenedor sobre-cab__grid">
    <div class="sobre-cab__texto">
      <h1 id="sobre-titulo">{{ presentacion.titulo }}</h1>
      <p class="sobre-lead">{{ presentacion.lead }}</p>
      <div class="texto-largo">
        {% for p in presentacion.parrafos %}<p>{{ p }}</p>{% endfor %}
      </div>
      {% if presentacion.foto %}<p class="sobre-datos">Psicóloga General Sanitaria · Colegiada {{ sitio.colegiada }} · {{ sitio.colegio }}</p>{% endif %}
    </div>
    {% if presentacion.foto %}
    <div class="sobre-foto">
      <img src="{{ presentacion.foto }}" alt="{{ presentacion.foto_alt }}" width="800" height="1000" fetchpriority="high">
    </div>
    {% else %}
    <div class="sobre-ficha">
      <p class="sobre-ficha__titulo">Psicóloga General Sanitaria</p>
      <p>Colegiada {{ sitio.colegiada }}</p>
      <p>{{ sitio.colegio }}</p>
    </div>
    {% endif %}
  </div>
</section>

{# 2 · MI FORMA DE ACOMPAÑAR #}
<section class="seccion seccion--niebla" id="acompanar" aria-labelledby="acompanar-titulo">
  <div class="contenedor dos">
    <h2 id="acompanar-titulo">{{ acompanar.titulo }}</h2>
    <div class="texto-largo">
      {% for p in acompanar.parrafos %}<p{% if loop.first %} class="destacado"{% endif %}>{{ p }}</p>{% endfor %}
    </div>
  </div>
</section>

{# 3 · CÓMO TRABAJO #}
<section class="seccion" id="como-trabajo" aria-labelledby="trabajo-titulo">
  <div class="contenedor dos">
    <h2 id="trabajo-titulo">{{ trabajo.titulo }}</h2>
    <div class="texto-largo">
      {% for p in trabajo.parrafos %}<p{% if loop.first %} class="destacado"{% endif %}>{{ p }}</p>{% endfor %}
    </div>
  </div>
</section>

{# 4 · QUÉ PUEDES ESPERAR #}
<section class="seccion seccion--niebla" id="que-esperar" aria-labelledby="esperar-titulo">
  <div class="contenedor">
    <div class="cabecera-seccion">
      <h2 id="esperar-titulo">{{ esperar.titulo }}</h2>
    </div>
    <ul class="esperar__lista">
      {% for e in esperar.lista %}
      <li class="esperar__item">
        <h3>{{ e.titulo }}</h3>
        <p>{{ e.texto }}</p>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>

{# 5 · FORMACIÓN #}
<section class="seccion" id="formacion" aria-labelledby="formacion-titulo">
  <div class="contenedor dos">
    <div>
      <h2 id="formacion-titulo">{{ formacion.titulo }}</h2>
      <p class="intro">{{ formacion.texto }}</p>
    </div>
    <ul class="titulos">
      {% for t in formacion.lista %}<li>{{ t }}</li>{% endfor %}
    </ul>
  </div>
</section>

{# 6 · EXPERIENCIA Y FORMACIÓN CONTINUA #}
<section class="seccion seccion--niebla" id="experiencia" aria-labelledby="experiencia-titulo">
  <div class="contenedor dos">
    <h2 id="experiencia-titulo">{{ experiencia.titulo }}</h2>
    <div class="texto-largo">
      {% for p in experiencia.parrafos %}<p>{{ p }}</p>{% endfor %}
      <a class="enlace" href="{{ experiencia.enlace_url }}">{{ experiencia.enlace }}{{ icono("flecha") }}</a>
    </div>
  </div>
</section>

{# 7 · CIERRE #}
<section class="cierre cierre--texto" aria-labelledby="cierre-sobre-titulo">
  <div class="contenedor">
    <h2 id="cierre-sobre-titulo">{{ cierre.titulo }}</h2>
    <div class="acciones acciones--arriba">
      <a class="btn" href="{{ sitio.cita_url }}">Pedir cita</a>
      <a class="enlace" href="{{ sitio.contacto_url }}">Contactar{{ icono("flecha") }}</a>
    </div>
  </div>
</section>
