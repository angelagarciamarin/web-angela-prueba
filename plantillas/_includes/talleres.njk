---
layout: base.njk
---
{% from "iconos.njk" import icono %}
{% set pt = collections.proximoTaller | first %}

{# ENCABEZADO #}
<section class="pagina-cab" aria-labelledby="talleres-pag-titulo">
  <div class="contenedor">
    <h1 id="talleres-pag-titulo">{{ encabezado.titulo }}</h1>
    <p class="intro intro--grande">{{ encabezado.texto }}</p>
  </div>
</section>

{# 1 · INFORMACIÓN GENERAL Y PRÁCTICA #}
<section class="seccion seccion--niebla" id="informacion" aria-labelledby="general-titulo">
  <div class="contenedor dos">
    <div>
      <h2 id="general-titulo" class="h2--ficha">{{ general.titulo }}</h2>
      <p class="intro">{{ general.texto }}</p>
    </div>
    <div>
      <h3 class="sub-titulo">{{ practica.titulo }}</h3>
      <dl class="datos">
        <div><dt>Edades y horarios</dt><dd>{% for g in talleres_comunes.grupos %}<span>{{ g.edades }}: {{ g.horario }}</span>{% endfor %}</dd></div>
        <div><dt>Lugar</dt><dd>{{ talleres_comunes.lugar }}</dd></div>
        <div><dt>Plazas</dt><dd>{{ talleres_comunes.aforo }}</dd></div>
        <div><dt>Precio</dt><dd><span>{{ talleres_comunes.precio_pacientes }} para pacientes de SANA · {{ talleres_comunes.precio_general }} tarifa general</span><span class="dato-nota">{{ talleres_comunes.nota_precio }}</span></dd></div>
        <div><dt>Inscripción</dt><dd>{{ practica.inscripcion }}</dd></div>
      </dl>
      <p class="dato-nota dato-nota--suelta">{{ practica.nota }}</p>
    </div>
  </div>
</section>

{# 2 · PRÓXIMO TALLER (solo aparece si hay un taller marcado como Próximo) #}
{% if pt %}
<section class="seccion" id="proximo-taller" aria-labelledby="proximo-titulo">
  <div class="contenedor">
    <h2 id="proximo-titulo" class="h2--ficha">{{ proximo.titulo }}</h2>
    <article class="proximo proximo--grande">
      <img src="{{ pt.data.cartel or talleres_comunes.cartel_generico }}" alt="{% if pt.data.cartel %}Cartel del taller {{ pt.data.titulo }}{% endif %}" width="400" height="500" loading="lazy">
      <div class="proximo__datos">
        <p class="proximo__fecha">{% if pt.data.fecha %}{{ pt.data.fecha }}{% else %}{{ pt.data.mes }} {{ pt.data.anio }} · Fecha por confirmar{% endif %}</p>
        <h3>{{ pt.data.titulo }}</h3>
        <p>{{ pt.data.objetivo }}</p>
        {% if pt.data.trabajaremos | length %}
        <ul class="trabajaremos">{% for x in pt.data.trabajaremos %}<li>{{ x }}</li>{% endfor %}</ul>
        {% endif %}
        <dl class="datos datos--compacto">
          <div><dt>Edades</dt><dd>{{ pt.data.edades or talleres_comunes.edades }}</dd></div>
          <div><dt>Horario</dt><dd>{% if pt.data.horarios %}{{ pt.data.horarios }}{% else %}{% for g in talleres_comunes.grupos %}<span>{{ g.edades }}: {{ g.horario }}</span>{% endfor %}{% endif %}</dd></div>
          <div><dt>Lugar</dt><dd>{{ pt.data.lugar or talleres_comunes.lugar }}</dd></div>
          <div><dt>Plazas</dt><dd>{{ pt.data.aforo or talleres_comunes.aforo }}</dd></div>
          <div><dt>Precio</dt><dd>{% if pt.data.precio %}{{ pt.data.precio }}{% else %}<span>{{ talleres_comunes.precio_pacientes }} para pacientes de SANA · {{ talleres_comunes.precio_general }} tarifa general</span>{% endif %}</dd></div>
        </dl>
        <div class="acciones acciones--arriba">
          <a class="btn" href="{{ pt.data.enlace_reserva or sitio.whatsapp_url }}" target="_blank" rel="noopener noreferrer">{{ proximo.boton }}</a>
          <a class="enlace" href="{{ sitio.telefono_url }}">o llama al {{ sitio.telefono }}</a>
        </div>
      </div>
    </article>
  </div>
</section>
{% endif %}

{# 3 · PROGRAMACIÓN DEL CURSO (siempre visibles los 10; solo cambia la etiqueta) #}
<section class="seccion{% if pt %} seccion--niebla{% endif %}" id="programacion" aria-labelledby="programacion-titulo">
  <div class="contenedor">
    <div class="cabecera-seccion">
      <h2 id="programacion-titulo" class="h2--ficha">{{ programacion.titulo }}</h2>
      <p class="intro">{{ programacion.texto }}</p>
    </div>
    <ul class="programacion">
      {% for t in collections.talleres %}{% if t.data.curso == programacion.curso %}
      <li class="taller-card">
        <p class="taller-card__mes">
          <span>{% if t.data.mes_por_confirmar %}Mes por confirmar{% else %}{{ t.data.mes }} {{ t.data.anio }}{% endif %}</span>
          <span class="etiqueta etiqueta--{% if t.data.estado == 'Próximo' %}proximo{% elif t.data.estado == 'Realizado' %}realizado{% else %}previsto{% endif %}">{{ t.data.estado }}</span>
        </p>
        <h3>{{ t.data.titulo }}</h3>
        <p class="taller-card__objetivo">{{ t.data.objetivo }}</p>
        {% if t.data.fecha %}<p class="taller-card__fecha">{{ t.data.fecha }}</p>{% elif t.data.estado != 'Realizado' and not t.data.mes_por_confirmar %}<p class="taller-card__fecha">Fecha por confirmar</p>{% endif %}
        {% if t.data.trabajaremos | length %}
        <details>
          <summary>Qué trabajaremos</summary>
          <ul>{% for x in t.data.trabajaremos %}<li>{{ x }}</li>{% endfor %}</ul>
        </details>
        {% endif %}
      </li>
      {% endif %}{% endfor %}
    </ul>
  </div>
</section>

{# 4 · TALLERES ANTERIORES (histórico, del más reciente al más antiguo) #}
<section class="seccion{% if not pt %} seccion--niebla{% endif %}" id="anteriores" aria-labelledby="anteriores-titulo">
  <div class="contenedor">
    <h2 id="anteriores-titulo" class="h2--ficha">{{ anteriores.titulo }}</h2>
    <ul class="anteriores">
      {% for t in collections.talleres | reverse %}{% if t.data.estado == 'Realizado' %}
      <li class="taller-previo{% if t.data.cartel %} taller-previo--cartel{% endif %}">
        {% if t.data.cartel %}
        <figure class="taller-previo__cartel">
          <img src="{{ t.data.cartel }}" alt="Cartel del taller {{ t.data.titulo }}" loading="lazy">
          <figcaption>{{ anteriores.nota_cartel }}</figcaption>
        </figure>
        {% endif %}
        <div>
          <p class="taller-card__mes"><span>{% if t.data.fecha %}{{ t.data.fecha }}{% else %}{{ t.data.mes }} {{ t.data.anio }}{% endif %}</span></p>
          <h3>{{ t.data.titulo }}</h3>
          <p class="taller-card__edades">{{ t.data.edades or talleres_comunes.edades }}</p>
          <p class="taller-card__objetivo">{{ t.data.objetivo }}</p>
          {% if t.data.trabajaremos | length %}
          <details>
            <summary>Qué trabajamos</summary>
            <ul>{% for x in t.data.trabajaremos %}<li>{{ x }}</li>{% endfor %}</ul>
          </details>
          {% endif %}
        </div>
      </li>
      {% endif %}{% endfor %}
    </ul>
  </div>
</section>

{# CIERRE #}
<section class="cierre cierre--texto" aria-labelledby="cierre-talleres-titulo">
  <div class="contenedor">
    <h2 id="cierre-talleres-titulo">{{ cierre.titulo }}</h2>
    <p class="cierre__texto">{{ cierre.texto }}</p>
    <div class="acciones acciones--arriba">
      <a class="btn" href="{{ sitio.whatsapp_url }}" target="_blank" rel="noopener noreferrer">Escribir por WhatsApp</a>
      <a class="enlace" href="{{ sitio.telefono_url }}">Llamar al {{ sitio.telefono }}{{ icono("flecha") }}</a>
    </div>
  </div>
</section>
