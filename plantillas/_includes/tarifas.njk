---
layout: base.njk
---
{% from "iconos.njk" import icono %}

{# ENCABEZADO + PRECIOS POR UBICACIÓN #}
<section class="pagina-cab pagina-cab--tarifas" aria-labelledby="tarifas-titulo">
  <div class="contenedor">
    <h1 id="tarifas-titulo">{{ encabezado.titulo }}</h1>
    <p class="intro intro--grande">{{ encabezado.texto }}</p>

    <div class="pestanas" data-pestanas>
      <div class="pestanas__lista" role="tablist" aria-label="Ubicación" hidden></div>
      {% for s in sedes %}
      <section class="pestanas__panel" id="{{ s.id }}" data-titulo="{{ s.nombre }}" aria-labelledby="titulo-{{ s.id }}">
        <h2 class="panel-titulo" id="titulo-{{ s.id }}">{{ s.nombre }}</h2>
        {% for u in sitio.ubicaciones %}{% if u.nombre == s.nombre %}<p class="panel-nota">{{ u.calle }}, {{ u.localidad }}</p>{% endif %}{% endfor %}
        {% if s.nota %}<p class="panel-nota">{{ s.nota }}</p>{% endif %}
        <ul class="tarifas-lista">
          {% for t in s.servicios %}
          <li>
            <h3 class="tarifa__nombre">{{ t.nombre }}</h3>
            <p class="tarifa__duracion">{{ t.duracion }}</p>
            <p class="tarifa__precio">{{ t.precio }}</p>
            {% if t.detalle %}<p class="tarifa__detalle">{{ t.detalle }}</p>{% endif %}
          </li>
          {% endfor %}
        </ul>
      </section>
      {% endfor %}
    </div>
  </div>
</section>

{# INFORMACIÓN PRÁCTICA #}
<section class="seccion seccion--niebla" id="informacion-practica" aria-labelledby="practica-titulo">
  <div class="contenedor dos">
    <h2 id="practica-titulo">{{ practica.titulo }}</h2>
    <ul class="practica__lista">
      {% for p in practica.lista %}
      <li>
        <h3>{{ p.titulo }}</h3>
        <p>{{ p.texto }}</p>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>

{# CIERRE #}
<section class="cierre cierre--texto" aria-labelledby="cierre-tarifas-titulo">
  <div class="contenedor">
    <h2 id="cierre-tarifas-titulo">{{ cierre.titulo }}</h2>
    <p class="cierre__texto">{{ cierre.texto }}</p>
    <div class="acciones acciones--arriba">
      <a class="btn" href="{{ sitio.cita_url }}">Pedir cita</a>
      <a class="enlace" href="{{ sitio.contacto_url }}">Contactar{{ icono("flecha") }}</a>
    </div>
  </div>
</section>
